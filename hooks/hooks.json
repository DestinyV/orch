{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-start.js\"",
            "description": "Check incomplete workflows and restore state on session start",
            "timeout": 10
          }
        ],
        "id": "session:init"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/stage-gate.js\"",
            "description": "Stage gate: block Skill calls when prerequisite stages are incomplete",
            "timeout": 5
          }
        ],
        "id": "pretool:stage-gate"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/suggest-compact.js\"",
            "description": "Suggest /compact at logical boundaries after 40 Edit/Write ops",
            "timeout": 5
          }
        ],
        "id": "pre:compact"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/observe.sh\"",
            "description": "Observe tool calls for instinct learning (fail-open, non-blocking)",
            "timeout": 5
          }
        ],
        "id": "pre:observe"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/workflow-gate.js\"",
            "description": "HARD-GATE validation: stage sequence, output files, state consistency. Standard mode: fail-open (warn). Goal mode: fail-closed on @critical paths.",
            "timeout": 5
          }
        ],
        "id": "posttool:hard-gate"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/observe.sh\"",
            "description": "Observe tool calls for instinct learning (fail-open, non-blocking)",
            "timeout": 5
          }
        ],
        "id": "post:observe"
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre-compact.js\"",
            "description": "Save workflow state before compaction",
            "timeout": 5
          }
        ],
        "id": "precompact:state"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-evaluate.js\"",
            "description": "Evaluate session + detect incomplete workflow for continuation",
            "timeout": 10
          }
        ],
        "id": "stop:evaluate"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/cost-tracker.js\"",
            "description": "Track token and cost metrics per session (JSONL + SQLite)",
            "timeout": 10
          }
        ],
        "id": "stop:cost-tracker"
      }
    ]
  }
}
